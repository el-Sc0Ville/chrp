# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Firebase credentials (provided at build time, never committed)
GoogleService-Info.plist
google-services.json

# typescript
*.tsbuildinfo

# generated native folders
/android
ios/Pods/
ios/build/

# Firebase emulator artifacts
firestore-debug.log
firebase-debug.log
ui-debug.log

# Local build artifacts
*.ipa
*.cer
build.log

# Firebase deploy cache
.firebase/

# Firebase admin keys (used once by functions/scripts/seed-demo.js; never commit)
*firebase-adminsdk*.json
*-service-account*.json
