{
  "expo": {
    "name": "Chrp",
    "slug": "chrp",
    "version": "1.0.0",
    "scheme": "chrp",
    "orientation": "portrait",
    "icon": "./assets/chrp-icon-1024.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/chrp-icon-1024.png",
      "backgroundColor": "#070B14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chrp.app",
      "associatedDomains": ["applinks:chrp-app.firebaseapp.com"],
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["chrp"]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Chrp uses your location to automatically check you in when you arrive at the venue.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Chrp checks you in automatically when you arrive at the venue, even if the app isn't open, so your team knows you made it.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.chrp.app",
      "googleServicesFile": "./android/app/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#070B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F6BFF",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Chrp uses your location to automatically check you in when you arrive at the venue.",
          "locationWhenInUsePermission": "Chrp uses your location to automatically check you in when you arrive at the venue.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "16e2f5c6-2e3a-4dad-9b51-8b485329db64"
      }
    },
    "owner": "el-sc0ville"
  }
}