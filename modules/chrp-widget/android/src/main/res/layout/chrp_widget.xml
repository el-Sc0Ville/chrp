<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout: only widget-safe views (LinearLayout, FrameLayout, TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/chrp_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <!-- Header: team switch (tap to cycle when on several teams) and ‹ 1/5 ›. -->
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <LinearLayout
      android:id="@+id/chrp_team_chip"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingTop="3dp"
      android:paddingBottom="3dp">
      <TextView
        android:id="@+id/chrp_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="●"
        android:textColor="#FF2540D6"
        android:textSize="9sp" />
      <TextView
        android:id="@+id/chrp_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="CHRP"
        android:textColor="#B3FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />
    </LinearLayout>
    <TextView
      android:id="@+id/chrp_prev"
      android:layout_width="28dp"
      android:layout_height="24dp"
      android:gravity="center"
      android:text="‹"
      android:textColor="#E6FFFFFF"
      android:textSize="18sp"
      android:textStyle="bold"
      android:visibility="gone" />
    <TextView
      android:id="@+id/chrp_pos"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="1/1"
      android:textColor="#B3FFFFFF"
      android:textSize="10sp"
      android:textStyle="bold"
      android:visibility="gone" />
    <TextView
      android:id="@+id/chrp_next"
      android:layout_width="28dp"
      android:layout_height="24dp"
      android:gravity="center"
      android:text="›"
      android:textColor="#E6FFFFFF"
      android:textSize="18sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/chrp_message"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:maxLines="4"
    android:text="Open Chrp once to see your next game here."
    android:textColor="#FFFFFFFF"
    android:textSize="14sp"
    android:textStyle="bold"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/chrp_event"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/chrp_event_team"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="TEAM"
      android:textColor="#FF2540D6"
      android:textSize="9sp"
      android:textStyle="bold"
      android:visibility="gone" />
    <TextView
      android:id="@+id/chrp_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="Next game"
      android:textColor="#FFFFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />
    <TextView
      android:id="@+id/chrp_when"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="Sat, Oct 25 · 8:30 PM"
      android:textColor="#CCFFFFFF"
      android:textSize="12sp" />
    <TextView
      android:id="@+id/chrp_venue"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="Your rink"
      android:textColor="#8CFFFFFF"
      android:textSize="11sp" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1" />
    <TextView
      android:id="@+id/chrp_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:text="Are you in?"
      android:textColor="#FFFFFFFF"
      android:textSize="11sp"
      android:textStyle="bold" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/chrp_btn_in"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_weight="1"
        android:background="@drawable/chrp_btn_in_off"
        android:gravity="center"
        android:text="I\'m in"
        android:textColor="#FF22C55E"
        android:textSize="12sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/chrp_btn_maybe"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/chrp_btn_maybe_off"
        android:gravity="center"
        android:text="Maybe"
        android:textColor="#FFF59E0B"
        android:textSize="12sp"
        android:textStyle="bold" />
      <TextView
        android:id="@+id/chrp_btn_out"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/chrp_btn_out_off"
        android:gravity="center"
        android:text="Out"
        android:textColor="#FFEF4444"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
